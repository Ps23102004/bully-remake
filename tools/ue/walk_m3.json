    {"do": "action_shot", "name": "c_run_jump_apex_side", "x": 21500, "y": 7330, "gait": "run", "cam": "side", "pitch": -4, "jump": true, "jump_at": 1.2, "trigger": "apex", "after": 1.2},
    {"do": "action_shot", "name": "c2_run_jump_air_behind", "x": 21500, "y": 7330, "gait": "run", "cam": "lock", "jump": true, "jump_at": 1.2, "trigger": "air", "trigger_time": 0.3, "after": 1.2},
